public class Main {

    public static void main(String[] args) {

        Series series = new Series();

        boolean running = true;

        while (running) {

            System.out.println("\n==============================");
            System.out.println(" TV SERIES MANAGEMENT SYSTEM");
            System.out.println("==============================");

            System.out.println("1. Capture a new series");
            System.out.println("2. Search for a series");
            System.out.println("3. Update a series");
            System.out.println("4. Delete a series");
            System.out.println("5. View series report");
            System.out.println("6. Exit");

            System.out.print("Please select an option: ");

            String choice = series.getScanner().nextLine();

            switch (choice) {

                case "1":
                    series.CaptureSeries();
                    break;

                case "2":
                    series.SearchSeries();
                    break;

                case "3":
                    series.UpdateSeries();
                    break;

                case "4":
                    series.DeleteSeries();
                    break;

                case "5":
                    series.SeriesReport();
                    break;

                case "6":
                    series.ExitSeriesApplication();
                    running = false;
                    break;

                default:
                    System.out.println(
                            "Invalid option. Please select 1 to 6.");
            }
        }
    }
}
